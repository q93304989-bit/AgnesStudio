# =================================================================
# Agnes Studio — 环境变量样例
# 复制为 .env 后填入你的真实密钥；.env 已在 .gitignore 中，不会被提交。
# =================================================================

# ---------- Agnes 图像/视频 API ----------
# 在 https://www.agnes-ai.com 注册后从控制台获取 API Key
AGNES_API_KEY=sk-your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# 图像默认模型（写生图 / 图生图都用）
AGNES_CHAT_MODEL=agnes-image-2.1-flash

# ---------- 图床（视频参考图自动上传用，二选一） ----------
# 推荐免费方案 A：GitHub
# 1. 新建一个公开仓库（如 <your-name>/my-images）
# 2. 生成 PAT：https://github.com/settings/tokens → 勾选 public_repo
# 3. 把 token 和仓库填到下面两行
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=your-github-username/your-image-repo

# 付费方案 B：S.EE（每月 $5.99 起）—— 用户中心生成 API Key 后填这行
SEE_API_TOKEN=

# ---------- 可选：千问 / DeepSeek / 智谱 ----------
# 仅在你需要做 prompt 润色、聊天改写时启用；本工具不直接使用，留作参考。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=

ZHIPU_API_KEY=